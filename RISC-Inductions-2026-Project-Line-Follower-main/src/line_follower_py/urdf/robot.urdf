<robot name="line_follower_robot">

  <link name="base_link">
    <visual name="chassis">
      <origin xyz="-0.0175 0 0.022" rpy="0 0 0"/>
      <geometry><box size="0.095 0.110 0.024"/></geometry>
      <material name="brightred"><color rgba="1 0 0 1"/></material>
    </visual>
    <collision name="chassis_collision">
      <origin xyz="-0.0175 0 0.022" rpy="0 0 0"/>
      <geometry><box size="0.095 0.110 0.024"/></geometry>
    </collision>
    <visual name="camera_post">
      <origin xyz="0.025 0 0.037" rpy="0 0 0"/>
      <geometry><box size="0.010 0.030 0.006"/></geometry>
      <material name="bracket_grey"><color rgba="0.3 0.3 0.3 1"/></material>
    </visual>
    <collision name="camera_post_collision">
      <origin xyz="0.025 0 0.037" rpy="0 0 0"/>
      <geometry><box size="0.010 0.030 0.006"/></geometry>
    </collision>
    <visual name="camera_arm">
      <origin xyz="0.0515 0 0.037" rpy="0 0 0"/>
      <geometry><box size="0.063 0.030 0.006"/></geometry>
      <material name="bracket_grey2"><color rgba="0.3 0.3 0.3 1"/></material>
    </visual>
    <collision name="camera_arm_collision">
      <origin xyz="0.0515 0 0.037" rpy="0 0 0"/>
      <geometry><box size="0.063 0.030 0.006"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.022" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <link name="left_front_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.02" length="0.016"/></geometry>
      <material name="wheel_material"><color rgba="0.12 0.12 0.12 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.02" length="0.016"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <link name="right_front_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.02" length="0.016"/></geometry>
      <material name="wheel_material"><color rgba="0.12 0.12 0.12 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.02" length="0.016"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <link name="left_rear_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.02" length="0.016"/></geometry>
      <material name="wheel_material"><color rgba="0.12 0.12 0.12 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.02" length="0.016"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <link name="right_rear_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.02" length="0.016"/></geometry>
      <material name="wheel_material"><color rgba="0.12 0.12 0.12 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.02" length="0.016"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <link name="camera_link">
    <visual name="camera_body">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.018 0.030 0.010"/></geometry>
      <material name="camera_blue"><color rgba="0.05 0.3 1.0 1"/></material>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
  </link>

  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="left_front_wheel"/>
    <origin xyz="0.045 0.065 0.020" rpy="0 0 0"/><axis xyz="0 1 0"/>
  </joint>
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="right_front_wheel"/>
    <origin xyz="0.045 -0.065 0.020" rpy="0 0 0"/><axis xyz="0 1 0"/>
  </joint>
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="left_rear_wheel"/>
    <origin xyz="-0.045 0.065 0.020" rpy="0 0 0"/><axis xyz="0 1 0"/>
  </joint>
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="right_rear_wheel"/>
    <origin xyz="-0.045 -0.065 0.020" rpy="0 0 0"/><axis xyz="0 1 0"/>
  </joint>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.074 0 0.029" rpy="0 0 0"/>
  </joint>

  <gazebo reference="camera_link">
    <sensor name="line_camera" type="camera">
      <pose>0 0 -0.005 0 1.5707963268 0</pose>
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <topic>/camera/image</topic>
      <camera name="line_camera">
        <horizontal_fov>2.8484</horizontal_fov>
        <image>
          <width>320</width>
          <height>240</height>
          <format>R8G8B8</format>
        </image>
        <clip><near>0.005</near><far>0.5</far></clip>
      </camera>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <wheel_separation>0.130</wheel_separation>
      <wheel_radius>0.020</wheel_radius>
      <odometry_publish_frequency>50</odometry_publish_frequency>
      <robot_base_frame>base_link</robot_base_frame>
      <topic>/cmd_vel</topic>
      <publish_odom_tf>false</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <joint_name>front_left_wheel_joint</joint_name>
      <joint_name>front_right_wheel_joint</joint_name>
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

  <gazebo reference="left_rear_wheel"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>
  <gazebo reference="right_rear_wheel"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>

</robot>
