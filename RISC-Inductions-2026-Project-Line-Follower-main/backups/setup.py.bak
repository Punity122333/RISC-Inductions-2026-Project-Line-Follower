import os
from glob import glob
from setuptools import find_packages, setup

package_name = 'line_follower_py'

setup(
    name=package_name,
    version='0.0.0',
    packages=find_packages(exclude=['test']),
    data_files=[
        ('share/ament_index/resource_index/packages', ['resource/' + package_name]),
        ('share/' + package_name, ['package.xml']),
        (os.path.join('share', package_name, 'launch'), glob('launch/*.py') + glob('launch/*.rviz')),
        (os.path.join('share', package_name, 'urdf'), glob('urdf/*.urdf') + glob('urdf/*.stl')),
        (os.path.join('share', package_name, 'worlds'), glob('worlds/*.sdf')),
        (os.path.join('share', package_name, 'meshes'), glob('meshes/*')),
    ],
    install_requires=['setuptools'],
    zip_safe=True,
    maintainer='parth',
    maintainer_email='parth@todo.todo',
    description='ROS 2 Line Follower RL Controller',
    license='Apache-2.0',
    entry_points={
        'console_scripts': [
            'line_detector = line_follower_py.line_detector:main',
            'gazebo_line_sim = line_follower_py.gazebo_line_sim:main',
            'track_publisher = line_follower_py.track_publisher:main',
            'grading_node = line_follower_py.grading_node:main',
        ]
    },
)