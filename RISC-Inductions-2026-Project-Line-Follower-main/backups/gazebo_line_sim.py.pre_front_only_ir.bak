#!/usr/bin/env python3
"""IR line-sensor simulator driven by Gazebo ground truth.

Gazebo (diff-drive plugin) owns the robot's motion.  This node subscribes to
the bridged odometry topic, normalizes it into the odom frame (anchored at the
spawn pose), evaluates the 5 front + 1 rear IR array against the Monza
centerline, and publishes:

    /sensor_raw  (Int32MultiArray, 6 values)   -> consumed by line_detector
    /tf          (odom -> base_link)           -> RViz / grading node

The wheel physics happens in Gazebo; only the contact-less IR sensors are
simulated here (as point sensors on the painted line).
"""

import math

import numpy as np
import rclpy
from geometry_msgs.msg import TransformStamped
from nav_msgs.msg import Odometry
from rclpy.node import Node
from std_msgs.msg import Int32MultiArray
from tf2_ros import TransformBroadcaster

from line_follower_py.track_geometry import (  # noqa: E402
    LINE_HALF_WIDTH_M,
    SENSOR_FRONT_X,
    SENSOR_REAR_X,
    SENSOR_YS,
    distance_to_track,
    odom_track_pts,
)


def yaw_from_quat(q):
    siny_cosp = 2.0 * (q.w * q.z + q.x * q.y)
    cosy_cosp = 1.0 - 2.0 * (q.y * q.y + q.z * q.z)
    return math.atan2(siny_cosp, cosy_cosp)


class GazeboLineSimNode(Node):
    def __init__(self):
        super().__init__('gazebo_line_sim')

        self.declare_parameter('odom_topic', '/model/line_follower_robot/odometry')

        odom_topic = self.get_parameter('odom_topic').value
        self.create_subscription(Odometry, odom_topic, self.odom_cb, 10)

        self.sensor_pub = self.create_publisher(Int32MultiArray, '/sensor_raw', 10)
        self.tf_broadcaster = TransformBroadcaster(self)

        # Track centerline in the odom frame (anchored at spawn pose, yaw 0)
        self.track_pts = odom_track_pts()

        self.x = 0.0
        self.y = 0.0
        self.heading = 0.0
        self.v = 0.0
        self.w = 0.0
        self.has_pose = False
        self.prev_raw_yaw = 0.0
        self.relative_yaw = 0.0

        # 50 Hz: matches the diff-drive odometry rate (20 Hz leaves the
        # controller acting on up to 30 ms stale sensor data)
        self.create_timer(0.05, self.update)
        self.status_timer = self.create_timer(5.0, self.log_status)
        self.get_logger().info(
            f'IR Sensor Simulator running (Gazebo odometry driven, '
            f'{len(self.track_pts)} track points, line half-width '
            f'{LINE_HALF_WIDTH_M * 1000:.1f} mm).')

    def odom_cb(self, msg: Odometry):
        p = msg.pose.pose.position
        raw_yaw = yaw_from_quat(msg.pose.pose.orientation)

        if not self.has_pose:
            # Normalize odometry into the track frame. Gazebo may preserve a
            # previous model pose, and quaternion yaw wraps at +/- pi.
            self.origin_x = float(p.x)
            self.origin_y = float(p.y)
            self.origin_yaw = raw_yaw
            self.prev_raw_yaw = raw_yaw
            self.get_logger().info(
                f'First odometry received: ({p.x:.3f}, {p.y:.3f}, '
                f'yaw {raw_yaw:.3f}). Using as origin.')
            self.has_pose = True
        else:
            yaw_delta = (raw_yaw - self.prev_raw_yaw + math.pi) % (2.0 * math.pi) - math.pi
            self.relative_yaw += yaw_delta
            self.prev_raw_yaw = raw_yaw

        dx = float(p.x) - self.origin_x
        dy = float(p.y) - self.origin_y
        c = math.cos(self.origin_yaw)
        s = math.sin(self.origin_yaw)
        self.x = c * dx + s * dy
        self.y = -s * dx + c * dy
        self.heading = self.relative_yaw
        self.v = float(msg.twist.twist.linear.x)
        self.w = float(msg.twist.twist.angular.z)

    def update(self):
        if not self.has_pose:
            return

        # Broadcast odom -> base_link so RViz and the grading node see motion
        t = TransformStamped()
        t.header.stamp = self.get_clock().now().to_msg()
        t.header.frame_id = 'odom'
        t.child_frame_id = 'base_link'
        t.transform.translation.x = float(self.x)
        t.transform.translation.y = float(self.y)
        t.transform.translation.z = 0.0
        t.transform.rotation.z = float(np.sin(self.heading / 2.0))
        t.transform.rotation.w = float(np.cos(self.heading / 2.0))
        self.tf_broadcaster.sendTransform(t)

        # IR array readings against the painted line
        rot = np.array([
            [np.cos(self.heading), -np.sin(self.heading)],
            [np.sin(self.heading), np.cos(self.heading)],
        ])
        pos = np.array([self.x, self.y])

        readings = []
        for y_off in SENSOR_YS:
            world_pt = pos + rot @ np.array([SENSOR_FRONT_X, y_off])
            dist = distance_to_track(self.track_pts, world_pt)
            readings.append(1 if dist <= LINE_HALF_WIDTH_M else 0)

        rear_pt = pos + rot @ np.array([SENSOR_REAR_X, 0.0])
        dist_rear = distance_to_track(self.track_pts, rear_pt)
        readings.append(1 if dist_rear <= LINE_HALF_WIDTH_M else 0)

        msg = Int32MultiArray()
        msg.data = readings
        self.sensor_pub.publish(msg)

    def log_status(self):
        if not self.has_pose:
            self.get_logger().warn(
                'Waiting for odometry on /odom - is the robot spawned in Gazebo?',
                throttle_duration_sec=10.0)
            return
        self.get_logger().info(
            f'pose=({self.x:6.3f}, {self.y:6.3f}) heading={self.heading:6.3f} '
            f'v={self.v * 1000:5.0f} mm/s')


def main(args=None):
    rclpy.init(args=args)
    node = GazeboLineSimNode()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()
