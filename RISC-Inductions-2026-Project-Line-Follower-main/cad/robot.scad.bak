$fn = 64;

part_id   = 0;
show_pose = 1;

chassis_len     = 140;
chassis_wid     = 110;
chassis_h       = 32;
ground_clear    = 6;
chassis_bot     = ground_clear;
chassis_top     = chassis_bot + chassis_h;

wall_thk        = 2.5;
floor_thk       = 4;
floor_top       = chassis_bot + floor_thk;
bot_cham        = 1.2;
arch_depth      = 0.8;

deck_thk        = 3;
deck_top        = 31;
deck_bot        = deck_top - deck_thk;

cowl_x          = -58;
cowl_top        = chassis_top;

nose_x          = 40;
nose_top        = 25;
nose_k          = (deck_top - nose_top) / (chassis_len / 2 - nose_x);

wheel_d         = 40;
wheel_w         = 16;
wheel_gap       = 2;
wheel_x         = 45;
axle_z          = wheel_d / 2;
wheel_y         = chassis_wid / 2 + wheel_gap + wheel_w / 2;

motor_can_d     = 12;
motor_can_len   = 10;
motor_gear_len  = 15;
motor_gear_x    = 12;
motor_gear_z    = 10;
motor_shaft_d   = 3;
motor_shaft_len = 13;
motor_body_len  = motor_can_len + motor_gear_len;

mcu_len         = 45;
mcu_wid         = 18;
mcu_x           = -43.9;
mcu_y           = 20.2;
mcu_thk         = 1.6;
mcu_z           = deck_bot + 0.4;

drv_size        = 21;
drv_x           = 0;
drv_y           = 32;

batt_len        = 62;
batt_wid        = 32;
batt_thk        = 16;
batt_x          = 11;
batt_y          = 0;
batt_z          = chassis_bot + 1.5;

sen_pcb_w       = 11;
sen_pcb_h       = 7;
sen_sink        = 2.4;
sen_face_z      = chassis_bot;
sen_front_x     = 54;
sen_rear_x      = -62;
sen_ys          = [32, 16, 0, -16, -32];

assert(chassis_len <= 150 && chassis_wid <= 150 && chassis_h <= 40);
assert(chassis_bot >= ground_clear);
assert(chassis_top - chassis_bot == chassis_h);
assert(wheel_y - wheel_w / 2 - chassis_wid / 2 >= wheel_gap - 0.01);
assert(abs(wheel_x) + wheel_d / 2 <= chassis_len / 2);
assert(axle_z == wheel_d / 2);
assert(motor_body_len == 25);
assert(deck_bot - floor_top > batt_thk);
assert(sen_front_x + sen_pcb_h / 2 <= chassis_len / 2);
assert(abs(sen_rear_x) + sen_pcb_h / 2 <= chassis_len / 2);
assert(max(sen_ys) + sen_pcb_w / 2 + 0.2 <= chassis_wid / 2);
assert(min(sen_ys) - sen_pcb_w / 2 - 0.2 >= -chassis_wid / 2);

module prof_outer() {
    hull() {
        for (p = [[-60, 45], [-60, -45], [46, 47], [46, -47], [58, 20], [58, -20]]) {
            r = p[0] < 0 ? 10 : (p[0] > 50 ? 12 : 8);
            translate(p) circle(r = r, $fn = 48);
        }
    }
}

module prof_inner() {
    offset(r = -wall_thk) prof_outer();
}

module x_le(v) {
    translate([-200, -200]) square([v + 200, 400]);
}

module x_ge(v) {
    translate([v, -200]) square([400, 400]);
}

module rrect(w, h, r) {
    offset(r = r) square([w - 2 * r, h - 2 * r], center = true);
}

module half_top() {
    translate([nose_x, 0, deck_top])
        rotate([0, atan(nose_k), 0])
            translate([-400, -200, 0]) cube([800, 400, 400]);
}

module half_bot() {
    translate([nose_x, 0, deck_bot])
        rotate([0, atan(nose_k), 0])
            translate([-400, -200, 0]) cube([800, 400, 400]);
}

module bot_chamfer() {
    hull() {
        translate([0, 0, chassis_bot]) linear_extrude(height = 0) prof_outer();
        translate([0, 0, chassis_bot + bot_cham]) linear_extrude(height = 0)
            offset(r = -bot_cham) prof_outer();
    }
}

module body_solid() {
    difference() {
        union() {
            translate([0, 0, chassis_bot])
                linear_extrude(height = deck_top - chassis_bot) prof_outer();
            translate([0, 0, deck_top])
                linear_extrude(height = cowl_top - deck_top)
                    intersection() {
                        prof_outer();
                        x_le(cowl_x);
                    }
        }
        translate([0, 0, chassis_bot]) half_top();
    }
}

module hollow() {
    union() {
        translate([0, 0, floor_top])
            linear_extrude(height = deck_bot - floor_top) prof_inner();
        difference() {
            translate([0, 0, deck_bot]) linear_extrude(height = 60)
                intersection() {
                    prof_inner();
                    x_ge(nose_x);
                }
            translate([0, 0, deck_bot]) half_bot();
        }
        translate([0, 0, deck_top]) linear_extrude(height = 60)
            intersection() {
                prof_inner();
                x_le(cowl_x);
            }
    }
}

module cradle_local() {
    difference() {
        union() {
            translate([-7, 37.5, 10]) cube([14, 15, 17]);
            translate([-9, 27.5, 10]) cube([18, 10, 15]);
            translate([-9, 28, 25]) cube([2.5, 6, 1]);
            translate([6.5, 28, 25]) cube([2.5, 6, 1]);
            translate([-9, 28, 26]) cube([18, 6, 1.6]);
        }
        translate([-6.2, 37.5, 14.8]) cube([12.4, 15.1, 10.4]);
        translate([0, 37.6, 20]) rotate([90, 0, 0]) cylinder(r = 6, h = 10.2, $fn = 32);
        translate([0, 42, 25.2]) cylinder(r = 1.1, h = 1.9, $fn = 16);
        translate([0, 31, 25.9]) cylinder(r = 1.1, h = 1.8, $fn = 16);
    }
}

module cradles() {
    for (mx = [-wheel_x, wheel_x])
        for (sgn = [-1, 1])
            translate([mx, 0, 0])
                mirror([0, sgn < 0 ? 1 : 0, 0])
                    cradle_local();
}

module sensor_pocket(x, y) {
    translate([x, y, 0]) {
        translate([-sen_pcb_h / 2 - 0.2, -sen_pcb_w / 2 - 0.2, chassis_bot])
            cube([sen_pcb_h + 0.4, sen_pcb_w + 0.4, sen_sink]);
        translate([-sen_pcb_h / 2 + 0.4, -sen_pcb_w / 2 + 0.4, chassis_bot + sen_sink])
            cube([sen_pcb_h - 0.8, sen_pcb_w - 0.8, floor_thk - sen_sink]);
    }
}

module sensor_bays() {
    for (yy = sen_ys) sensor_pocket(sen_front_x, yy);
    sensor_pocket(sen_rear_x, 0);
}

module batt_bay() {
    translate([batt_x, batt_y, 0]) {
        translate([-batt_len / 2 - 0.2, -batt_wid / 2 - 0.2, chassis_bot])
            cube([batt_len + 0.4, batt_wid + 0.4, 1.5]);
        for (y = [-18, 18])
            translate([-10.5, y - 1.5, chassis_bot]) cube([21, 3, floor_thk]);
    }
}

module mcu_posts() {
    for (xy = [[-63.5, 13.5], [-63.5, 25.5], [-25.5, 13.5], [-25.5, 25.5]]) {
        translate([xy[0], xy[1], floor_top]) cylinder(r = 3, h = mcu_z - floor_top, $fn = 24);
        translate([xy[0], xy[1], floor_top]) cylinder(r = 1.1, h = mcu_z - floor_top, $fn = 16);
    }
}

module mcu_hole() {
    translate([mcu_x, mcu_y, deck_bot])
        linear_extrude(height = deck_thk + 0.2) rrect(mcu_len + 0.4, mcu_wid + 0.4, 1);
}

module drv_pocket(y) {
    translate([drv_x, y, deck_top - 1.6])
        linear_extrude(height = 1.7) rrect(drv_size + 0.4, drv_size + 0.4, 1);
}

module deck_holes() {
    mcu_hole();
    drv_pocket(drv_y);
    drv_pocket(-drv_y);
    translate([-17, 0, deck_bot]) cube([8, 6, deck_thk + 0.2]);
    translate([0, 20, deck_bot]) cube([6, 6, deck_thk + 0.2]);
    translate([0, -20, deck_bot]) cube([6, 6, deck_thk + 0.2]);
}

module wall_openings() {
    translate([-chassis_len / 2 - 0.2, 15.5, 27]) cube([wall_thk + 0.5, 9, 5.5]);
    translate([-chassis_len / 2 - 0.2, -29.5, 22]) cube([wall_thk + 0.5, 9, 5]);
    for (mx = [-wheel_x, wheel_x])
        translate([mx, chassis_wid / 2 + 0.1, axle_z])
            rotate([90, 0, 0]) cylinder(r = 2.2, h = wall_thk + 0.6, $fn = 20);
}

module cable_troughs() {
    for (sgn = [-1, 1])
        translate([-50, sgn * 24 - 2, floor_top - 1.5]) cube([100, 4, 1.5]);
}

module wheel_arches() {
    for (mx = [-wheel_x, wheel_x])
        for (sgn = [-1, 1])
            translate([mx, sgn * (chassis_wid / 2 + 0.2), axle_z])
                rotate([0, sgn < 0 ? -90 : 90, 0])
                    cylinder(r = wheel_d / 2, h = arch_depth + 0.2, $fn = 48);
}

module chassis() {
    color([0.15, 0.35, 0.75]) {
        difference() {
            union() {
                difference() {
                    body_solid();
                    hollow();
                }
                cradles();
                mcu_posts();
            }
            sensor_bays();
            batt_bay();
            deck_holes();
            wall_openings();
            wheel_arches();
            cable_troughs();
            bot_chamfer();
            translate([-72, -45, deck_top]) cube([6, 90, 10]);
        }
    }
}

module wheel() {
    color([0.08, 0.08, 0.08]) {
        difference() {
            union() {
                difference() {
                    rotate([90, 0, 0]) cylinder(r = wheel_d / 2, h = wheel_w, center = true, $fn = 64);
                    rotate([90, 0, 0]) cylinder(r = 13, h = wheel_w + 0.2, center = true, $fn = 64);
                }
                rotate([90, 0, 0]) cylinder(r = 6.5, h = 14, center = true, $fn = 40);
                for (i = [0:5])
                    rotate([0, i * 60, 0])
                        hull() {
                            translate([0, 0, 0]) rotate([90, 0, 0])
                                cylinder(r = 4.5, h = 13, center = true, $fn = 24);
                            translate([12.5, 0, 0]) rotate([90, 0, 0])
                                cylinder(r = 3, h = 13, center = true, $fn = 24);
                        }
                translate([0, 7, 0]) rotate([90, 0, 0])
                    cylinder(r = 8, h = 1, center = true, $fn = 40);
                translate([0, 6, 0]) rotate([90, 0, 0])
                    cylinder(r = 6.8, h = 1, center = true, $fn = 40);
            }
            translate([0, 5, 0]) rotate([90, 0, 0]) cylinder(r = 1.6, h = 12, $fn = 24);
            translate([2.525, -1, 0]) cube([2.95, 12, 3], center = true);
            for (i = [0:15])
                rotate([0, i * 22.5 + (i % 2) * 11.25 + 5.625, 0])
                    translate([0, 0, 19.4]) cube([3, 17, 2.4], center = true);
        }
    }
}

module prof_collision() {
    hull() {
        for (p = [[-60, 45], [-60, -45], [46, 47], [46, -47], [58, 20], [58, -20]]) {
            r = p[0] < 0 ? 10 : (p[0] > 50 ? 12 : 8);
            translate(p) circle(r = r, $fn = 12);
        }
    }
}

module chassis_collision() {
    difference() {
        union() {
            translate([0, 0, chassis_bot])
                linear_extrude(height = deck_top - chassis_bot) prof_collision();
            translate([0, 0, deck_top])
                linear_extrude(height = cowl_top - deck_top)
                    intersection() {
                        prof_collision();
                        x_le(cowl_x);
                    }
        }
        translate([0, 0, chassis_bot]) half_top();
    }
}

module wheel_collision() {
    rotate([90, 0, 0]) cylinder(r = wheel_d / 2, h = wheel_w, center = true, $fn = 32);
}

module motor_body() {
    color([0.75, 0.75, 0.78]) {
        translate([0, 0, 0]) rotate([-90, 0, 0])
            cylinder(r = motor_shaft_d / 2, h = motor_shaft_len, $fn = 20);
        translate([0, -motor_gear_len / 2, 0])
            cube([motor_gear_x, motor_gear_len, motor_gear_z], center = true);
        translate([0, -motor_gear_len - motor_can_len / 2, 0]) rotate([-90, 0, 0])
            cylinder(r = motor_can_d / 2, h = motor_can_len, $fn = 40);
    }
}

module mcu_board() {
    color([0.1, 0.5, 0.2]) {
        translate([mcu_x, mcu_y, mcu_z]) cube([mcu_len, mcu_wid, mcu_thk], center = true);
        translate([mcu_x - mcu_len / 2 - 1.05, mcu_y, mcu_z + 0.8]) cube([2.1, 8, 4.5], center = true);
    }
}

module driver_board() {
    color([0.15, 0.15, 0.6]) {
        for (y = [drv_y, -drv_y])
            translate([drv_x, y, deck_top - 0.8]) cube([drv_size, drv_size, mcu_thk], center = true);
    }
}

module battery_pack() {
    color([0.9, 0.9, 0.25]) {
        translate([batt_x, batt_y, batt_z + batt_thk / 2])
            cube([batt_len, batt_wid, batt_thk], center = true);
    }
}

module sensor_module(x, y) {
    color([0.1, 0.1, 0.1]) {
        translate([x, y, chassis_bot + sen_sink + 0.8]) cube([sen_pcb_h, sen_pcb_w, 1.6], center = true);
        translate([x, y, chassis_bot + sen_sink / 2]) cylinder(r = 2, h = sen_sink, center = true, $fn = 24);
    }
}

module assembly() {
    render() chassis();
    for (wx = [-wheel_x, wheel_x])
        for (wy = [-wheel_y, wheel_y])
            translate([wx, wy, axle_z]) render() wheel();
    for (wx = [-wheel_x, wheel_x]) {
        translate([wx, chassis_wid / 2 - wall_thk, axle_z]) motor_body();
        translate([wx, -(chassis_wid / 2 - wall_thk), axle_z]) mirror([0, 1, 0]) motor_body();
    }
    mcu_board();
    driver_board();
    battery_pack();
    for (yy = sen_ys) sensor_module(sen_front_x, yy);
    sensor_module(sen_rear_x, 0);
}

if (show_pose) {
    echo("S0 front far-left  = [54, 32, 6]");
    echo("S1 front mid-left  = [54, 16, 6]");
    echo("S2 front center    = [54, 0, 6]");
    echo("S3 front mid-right = [54, -16, 6]");
    echo("S4 front far-right = [54, -32, 6]");
    echo("S5 rear center     = [-62, 0, 6]");
    echo("sensor pcb plane z = 9.2");
    echo("motor_FL = [-45, 40, 20]");
    echo("motor_FR = [-45, -40, 20]");
    echo("motor_RL = [45, 40, 20]");
    echo("motor_RR = [45, -40, 20]");
    echo("mcu = [-43.9, 20.2, 29.2]");
    echo("drv_L = [0, 32, 30.2]");
    echo("drv_R = [0, -32, 30.2]");
    echo("batt = [11, 0, 15.5]");
}

if (part_id == 1) chassis();
if (part_id == 2) wheel();
if (part_id == 3) chassis_collision();
if (part_id == 4) wheel_collision();
if (part_id == 0) assembly();